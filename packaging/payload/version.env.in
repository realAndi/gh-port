# Written by tools/build-deb.sh; read by the postinst.
#
# Unlike the sibling CCForiOS package, nothing is downloaded at install time:
# gh is MIT licensed, so the binary this was built from ships inside the .deb.
# GH_BINARY_SHA256 is therefore a check that dpkg laid down what was packaged,
# not a check on a third party's CDN.
GH_VERSION=@GH_VERSION@
GH_COMMIT=@GH_COMMIT@
GH_BINARY_SHA256=@GH_BINARY_SHA256@
